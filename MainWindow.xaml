<Window x:Class="PhotoEditorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhotoEditorApp.ViewModels"
        Title="Modern Desktop Photo Editor" Height="720" Width="1080"
        Background="#1E1E1E" Foreground="White" WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/> <!-- Workspace Canvas -->
            <ColumnDefinition Width="320"/> <!-- Control Panel -->
        </Grid.ColumnDefinitions>

        <!-- AREA KANVAS GAMBAR -->
        <Border Grid.Column="0" Background="#2D2D30" Margin="10" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <!-- Indikator Loading -->
                <TextBlock Text="Processing..." Foreground="LightSkyBlue" FontSize="18" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10"
                           Visibility="{Binding IsProcessing, Converter={x:Static BooleanToVisibilityConverter}}"/>
                
                <!-- ScrollViewer memungkinkan Pan otomatis ketika diperbesar -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image Source="{Binding DisplayImage}" Stretch="Uniform" Margin="20" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.LayoutTransform>
                            <!-- Fitur Zoom dapat dihubungkan via Slider jika dibutuhkan, ini adalah stub-nya -->
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- PANEL KONTROL -->
        <Border Grid.Column="1" Background="#252526" Padding="20">
            <StackPanel>
                <TextBlock Text="PHOTO STUDIO" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                
                <!-- File Ops -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding LoadCommand}" Content="Open Image" Height="35" Background="#007ACC" Foreground="White" BorderThickness="0"/>
                    <Button Command="{Binding SaveCommand}" Grid.Column="2" Content="Save As..." Height="35" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
                </Grid>

                <Separator Background="#3E3E42" Margin="0,0,0,20"/>

                <!-- Edit History -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding UndoCommand}" Content="↶ Undo" Height="30" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
                    <Button Command="{Binding RedoCommand}" Grid.Column="2" Content="↷ Redo" Height="30" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
                </Grid>

                <!-- Adjustments -->
                <TextBlock Text="Adjustments" FontSize="14" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,10"/>
                
                <TextBlock Text="Brightness" Foreground="White"/>
                <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}" 
                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,5,0,0">
                    <!-- Event ini memastikan kita memicu aksi CommitChanges ke Undo Stack setelah slider dilepas -->
                    <Slider.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding CommitAdjustmentsCommand}"/>
                    </Slider.InputBindings>
                </Slider>
                
                <TextBlock Text="Contrast" Foreground="White" Margin="0,15,0,0"/>
                <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast, UpdateSourceTrigger=PropertyChanged}" 
                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,5,0,20">
                    <Slider.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding CommitAdjustmentsCommand}"/>
                    </Slider.InputBindings>
                </Slider>
                
                <!-- Tombol Konfirmasi Slider -->
                <Button Command="{Binding CommitAdjustmentsCommand}" Content="Apply Adjustments" Height="30" Background="#007ACC" Foreground="White" BorderThickness="0" Margin="0,0,0,20"/>

                <Separator Background="#3E3E42" Margin="0,0,0,20"/>

                <!-- Filters -->
                <TextBlock Text="Quick Filters" FontSize="14" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,10"/>
                
                <Button Command="{Binding GrayscaleCommand}" Content="Grayscale" Height="35" Background="#3E3E42" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/>
                <Button Command="{Binding InvertCommand}" Content="Invert Colors" Height="35" Background="#3E3E42" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/>
                <Button Command="{Binding BlurCommand}" Content="Gaussian Blur" Height="35" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
                
            </StackPanel>
        </Border>
    </Grid>
</Window>
