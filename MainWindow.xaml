<Window x:Class="PhotoEditorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhotoEditorApp.ViewModels"
        Title="WPF Veteran Photo Editor" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Canvas -->
            <RowDefinition Height="Auto"/> <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0" Background="#F5F5F5">
            <ToolBar Padding="5">
                <Button Command="{Binding OpenCommand}" Content="📂 Open" Margin="0,0,5,0" Padding="10,5"/>
                <Button Command="{Binding SaveCommand}" Content="💾 Save" Margin="0,0,5,0" Padding="10,5"/>
                <Separator Margin="5,0"/>
                <Button Command="{Binding UndoCommand}" Content="↩ Undo" Margin="0,0,5,0" Padding="10,5"/>
                <Button Command="{Binding GrayscaleCommand}" Content="⚫ Grayscale" Margin="0,0,5,0" Padding="10,5"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Main Image Area with Scroll & Zoom capabilities setup -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#2D2D30">
            <Border Margin="20" Background="Transparent">
                <!-- Gunakan RenderOptions.BitmapScalingMode untuk scaling kualitas tinggi -->
                <Image Source="{Binding CurrentImage}" 
                       Stretch="Uniform" 
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.5" ShadowDepth="5"/>
                    </Image.Effect>
                </Image>
            </Border>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.Row="1" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Processing..." Foreground="White" FontSize="24" FontWeight="Bold"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="10" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="Ready" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
